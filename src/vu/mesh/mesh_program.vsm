        nop                                       iaddiu vi01,vi04,0
        nop                                       ibeq vi09,vi00,material_global_direction
        nop                                       iaddiu vi11,vi00,2
        nop                                       lq.xyz vf13,10(vi00)
        nop                                       lq.xyz vf14,3(vi04)
        sub.xyz vf13,vf13,vf14                    nop
        linear_xyz vf13,vf29,vf30,vf31,vf13
        nop                                       ibeq vi09,vi11,material_next_normal
        nop                                       nop
        nop                                       lq.xyzw vf15,2(vi07)
