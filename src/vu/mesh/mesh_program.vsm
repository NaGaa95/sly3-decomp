        itof0.xyzw vf06,vf06                      nop
        nop                                       ibne vi09,vi11,material_evaluate_gain
        nop                                       nop
        nop                                       lq.xyzw vf16,3(vi05)
        itof4.xyz vf16,vf16                       nop
        sub.xyz vf05,vf13,vf16                    nop
        nop                                       erleng p,vf05
        nop                                       waitp
        nop                                       mfp.w vf07,p
        mulw.xyz vf05,vf05,vf07w                  nop
material_evaluate_gain:
