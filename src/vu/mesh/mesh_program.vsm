        maddw.xyz vf24,vf14,vf00w                 iadd vi06,vi04,vi08
skin_normal_duplicate_position:
        nop                                       ilw.z vi08,0(vi06)
        nop                                       sq.xyz vf30,3(vi06)
        nop                                       nop
        nop                                       nop
        nop                                       ibltz vi08,skin_normal_duplicate_position
        nop                                       iadd vi06,vi04,vi08
skin_normal_after_duplicates:
        mulax.xyz acc,vf15,vf19x                  lq.xyzw vf20,1(vi05)
        madday.xyz acc,vf16,vf19y                 ibeq vi06,vi04,skin_normal_done
        maddaz.xyz acc,vf17,vf19z                 nop
        maddw.xyz vf25,vf18,vf00w                 nop
        itof0.xyzw vf20,vf20                      nop
        mulax.xyz acc,vf22,vf21x                  lq.xyzw vf19,3(vi05)
        madday.xyz acc,vf23,vf21y                 iaddi vi05,vi05,4
        maddaz.xyz acc,vf24,vf21z                 b skin_normal_pipeline
        maddw.xyz vf30,vf25,vf21w                 nop
skin_normal_done:
        nop                                       jr vi15
        nop                                       nop
end_native_routine mesh_skin_normals_positions

; Resolve relative GIF packet pointers, patch inherited header lanes, and XGKICK the first and optional second stream. Original zero-pointer branches are retained.
begin_native_routine mesh_kick_packet_pair
        nop                                       lq.xyzw vf01,8(vi04)
        nop                                       ibeq vi01,vi00,kick_done
        nop                                       iadd vi01,vi04,vi01
        nop                                       mtir vi03,vf01w
        nop                                       nop
        nop                                       ibeq vi03,vi00,kick_first_packet
        nop                                       iadd vi03,vi01,vi03
        nop                                       lq.xyzw vf01,2(vi03)
        nop                                       sq.xyzw vf01,3(vi01)
        nop                                       nop
        nop                                       nop
kick_first_packet:
        nop                                       iaddiu vi03,vi01,2
        nop                                       xgkick vi03
        nop                                       lq.xyzw vf01,0(vi01)
        nop                                       ibeq vi02,vi00,kick_done
        nop                                       iadd vi02,vi04,vi02
        nop                                       sq.yzw vf01,-1(vi02)
        nop                                       iaddi vi02,vi02,-1
        nop                                       nop
        nop                                       nop
        nop                                       xgkick vi02
kick_done:
        nop                                       jr vi15
        nop                                       nop
end_native_routine mesh_kick_packet_pair

; Accumulate signed XY fan area via ACC; compare status sign to native winding selection and empty the span on backface.
begin_native_routine mesh_cull_polygon
        nop                                       ilw.x vi01,packet_flags_qword(vi04)
        nop                                       iaddiu vi02,vi00,0x80
        suba.xyzw acc,vf00,vf00                   lq.xyzw vf09,3(vi05)
        nop                                       lq.xyzw vf10,7(vi05)
        nop                                       iand vi01,vi02,vi01
        nop                                       lq.xyzw vf11,11(vi05)
        nop                                       ibne vi01,vi00,polygon_cull_done
        sub.xy vf12,vf10,vf09                     iaddi vi12,vi05,8
polygon_area_next:
        sub.xy vf13,vf11,vf09                     iaddi vi12,vi12,4
        nop                                       lq.xyzw vf11,3(vi12)
        nop                                       nop
        nop                                       nop
        madday.x acc,vf13,vf12y                   nop
        msubay.x acc,vf12,vf13y                   ibne vi12,vi06,polygon_area_next
        nop                                       move.xyzw vf12,vf13
        nop                                       iadd vi02,vi07,vi07
        nop                                       nop
        nop                                       fsand vi01,2
        nop                                       nop
        nop                                       ibne vi01,vi02,polygon_cull_done
        nop                                       nop
        nop                                       iadd vi06,vi00,vi05
polygon_cull_done:
        nop                                       jr vi15
        nop                                       nop
end_native_routine mesh_cull_polygon

; Sutherland-Hodgman edge clipping for four-qword attributed vertices. Native signed plane distance and Q interpolation retain all attributes and the explicit W marker.
begin_native_routine mesh_clip_polygon_plane
        nop                                       iaddiu vi01,vi00,1
        nop                                       mfir.w vf20,vi01
        nop                                       lq.xyzw vf13,3(vi05)
        mul.xyzw vf14,vf01,vf13                   lq.xyzw vf10,0(vi05)
        addaz.w acc,vf14,vf14z                    lq.xyzw vf11,1(vi05)
        madday.w acc,vf00,vf14y                   lq.xyzw vf12,2(vi05)
        maddx.w vf14,vf00,vf14x                   nop
        nop                                       iadd vi12,vi00,vi05
        nop                                       iadd vi13,vi00,vi05
        nop                                       nop
        nop                                       fsand vi02,2
        nop                                       sq.xyzw vf10,0(vi06)
        nop                                       sq.xyzw vf11,1(vi06)
        nop                                       sq.xyzw vf12,2(vi06)
        nop                                       sq.xyzw vf13,3(vi06)
clip_edge_next:
        max.xyzw vf18,vf13,vf13xyzw               iadd vi03,vi00,vi02
        max.xyzw vf19,vf14,vf14xyzw               move.xyzw vf15,vf10
        max.xyzw vf16,vf11,vf11xyzw               move.xyzw vf17,vf12
        nop                                       lq.xyzw vf13,7(vi12)
        mul.xyzw vf14,vf01,vf13                   lq.xyzw vf10,4(vi12)
        addaz.w acc,vf14,vf14z                    lq.xyzw vf11,5(vi12)
        madday.w acc,vf00,vf14y                   lq.xyzw vf12,6(vi12)
        maddx.w vf14,vf00,vf14x                   nop
        nop                                       nop
        nop                                       nop
        nop                                       nop
        nop                                       fsand vi02,2
        nop                                       nop
        nop                                       ibeq vi03,vi02,clip_edge_no_intersection
        nop                                       nop
        sub.w vf09,vf14,vf19                      nop
        nop                                       div q,vf14w,vf09w
        subq.w vf09,vf00,q                        waitq
        mulaq.xyz acc,vf15,q                      nop
        maddw.xyz vf20,vf10,vf09w                 nop
        mulaq.xyzw acc,vf16,q                     nop
        maddw.xyzw vf21,vf11,vf09w                nop
        mulaq.xyzw acc,vf17,q                     nop
        maddw.xyzw vf22,vf12,vf09w                nop
        mulaq.xyzw acc,vf18,q                     nop
        maddw.xyzw vf23,vf13,vf09w                nop
        nop                                       sqi.xyzw vf20,(vi13++)
        nop                                       sqi.xyzw vf21,(vi13++)
        nop                                       sqi.xyzw vf22,(vi13++)
        nop                                       sqi.xyzw vf23,(vi13++)
clip_edge_no_intersection:
        nop                                       ibne vi02,vi00,clip_edge_next_input
        nop                                       nop
        nop                                       sqi.xyzw vf10,(vi13++)
        nop                                       sqi.xyzw vf11,(vi13++)
        nop                                       sqi.xyzw vf12,(vi13++)
        nop                                       sqi.xyzw vf13,(vi13++)
clip_edge_next_input:
        nop                                       iaddi vi12,vi12,4
        nop                                       nop
        nop                                       ibne vi12,vi06,clip_edge_next
        nop                                       nop
        nop                                       iadd vi06,vi00,vi13
        nop                                       jr vi15
        nop                                       nop
end_native_routine mesh_clip_polygon_plane

; Collect at most twenty unique projected XY positions. The original0.1 tolerance uses both MAC sign bits; full vertex W eligibility and exact-capacity return are preserved.
begin_native_routine mesh_collect_unique_xy
        nop                                       ilw.x vi13,0(vi08)
        nop                                       iadd vi13,vi13,vi04
        nop                                       iadd vi03,vi00,vi05
unique_xy_next_candidate:
        nop                                       iaddiu vi12,vi08,2
        nop                                       iaddiu vi01,vi12,0x14
        nop                                       ilw.w vi02,0(vi03)
        nop                                       ibeq vi13,vi01,unique_xy_done
        nop                                       lq.xyzw vf09,3(vi03)
        nop                                       iaddiu vi03,vi03,4
        nop                                       ibeq vi02,vi00,unique_xy_next
        nop                                       nop
unique_xy_find_existing:
        nop                                       ibeq vi12,vi13,unique_xy_append
        nop                                       lqi.xyzw vf10,(vi12++)
        sub.xy vf10,vf10,vf09                     nop
        ; I: unique XY tolerance0.1
        abs[i].xy vf10,vf10                       loi 0.10000000149011612
        subi.xy vf10,vf10,i                       nop
        nop                                       nop
        nop                                       nop
        nop                                       iaddiu vi01,vi00,0xc0
        nop                                       fmand vi02,vi01
        nop                                       nop
        nop                                       ibne vi02,vi01,unique_xy_find_existing
        nop                                       nop
        nop                                       b unique_xy_next
        nop                                       nop
unique_xy_append:
        nop                                       sqi.xyzw vf09,(vi13++)
unique_xy_next:
        nop                                       isub vi01,vi13,vi04
        nop                                       ibne vi03,vi06,unique_xy_next_candidate
        nop                                       isw.x vi01,0(vi08)
unique_xy_done:
        nop                                       jr vi15
        nop                                       nop
end_native_routine mesh_collect_unique_xy

; Normalize to homogeneous clipping space, clip negative/positive Z/X/Y as required, collect unique XY where requested, then perspective-map and integer-round all attribute records.
begin_native_routine mesh_clip_project_polygon
        save_micro_link
        nop                                       lq.xyzw vf04,9(vi04)
        nop                                       lq.xyzw vf05,1(vi00)
        nop                                       lq.xyzw vf06,0(vi00)
        mulx.w vf05,vf00,vf04x                    nop
        muly.w vf06,vf00,vf04y                    nop
        nop                                       div q,vf00w,vf06x
        addq.x vf08,vf00,q                        waitq
        nop                                       div q,vf00w,vf06y
        addq.y vf08,vf00,q                        waitq
        nop                                       div q,vf00w,vf06z
        addq.z vf08,vf00,q                        waitq
        nop                                       fcset 0
        nop                                       iadd vi12,vi00,vi05
clip_normalize_next:
        nop                                       lq.xyzw vf12,3(vi12)
        nop                                       lq.xyzw vf09,0(vi12)
        nop                                       lq.xyzw vf10,1(vi12)
        nop                                       lq.xyzw vf11,2(vi12)
        sub.xyz vf12,vf12,vf05                    nop
        mulw.xyz vf09,vf09,vf09w                  move.w vf12,vf09
        itof0.xyzw vf10,vf10                      mfir.w vf09,vi00
        itof0.xyzw vf11,vf11                      nop
        mul.xyz vf12,vf12,vf08                    nop
        mulw.xyz vf12,vf12,vf12w                  nop
        nop                                       sq.xyzw vf09,0(vi12)
        nop                                       sq.xyzw vf10,1(vi12)
        nop                                       sq.xyzw vf11,2(vi12)
        nop                                       sq.xyzw vf12,3(vi12)
        clipw.xyz vf12,vf12                       iaddi vi12,vi12,4
        nop                                       nop
        nop                                       ibne vi12,vi06,clip_normalize_next
        nop                                       nop
        nop                                       fcand vi01,0x410410
        nop                                       nop
        nop                                       ibeq vi01,vi00,clip_positive_z
        nop                                       nop
        max.xyw vf01,vf00,vf00xyw                 bal vi15,mesh_clip_polygon_plane
        subw.z vf01,vf00,vf00w                    nop
        nop                                       ibeq vi05,vi06,clip_empty_polygon
        nop                                       nop
        nop                                       ibeq vi08,vi00,clip_resample_flags
        nop                                       nop
        nop                                       bal vi15,mesh_collect_unique_xy
        nop                                       nop
clip_resample_flags:
        nop                                       fcset 0
        nop                                       lq.xyzw vf12,3(vi05)
        clipw.xyz vf12,vf12                       nop
        nop                                       lq.xyzw vf12,7(vi05)
        clipw.xyz vf12,vf12                       iaddi vi01,vi05,12
        nop                                       lq.xyzw vf12,11(vi05)
        clipw.xyz vf12,vf12                       ibeq vi06,vi01,clip_positive_z
        nop                                       lq.xyzw vf12,15(vi05)
        clipw.xyz vf12,vf12                       nop
clip_positive_z:
        nop                                       fcand vi01,0x820820
        nop                                       nop
        nop                                       ibeq vi01,vi00,clip_negative_x
        nop                                       nop
        max.xyw vf01,vf00,vf00xyw                 bal vi15,mesh_clip_polygon_plane
        addw.z vf01,vf00,vf00w                    nop
        nop                                       ibeq vi05,vi06,clip_empty_polygon
        nop                                       nop
clip_negative_x:
        nop                                       fcand vi01,0x41041
        nop                                       nop
        nop                                       ibeq vi01,vi00,clip_positive_x
        nop                                       nop
        max.yzw vf01,vf00,vf00yzw                 bal vi15,mesh_clip_polygon_plane
        subw.x vf01,vf00,vf00w                    nop
        nop                                       ibeq vi05,vi06,clip_empty_polygon
        nop                                       nop
clip_positive_x:
        nop                                       fcand vi01,0x82082
        nop                                       nop
        nop                                       ibeq vi01,vi00,clip_negative_y
        nop                                       nop
        max.yzw vf01,vf00,vf00yzw                 bal vi15,mesh_clip_polygon_plane
        addw.x vf01,vf00,vf00w                    nop
        nop                                       ibeq vi05,vi06,clip_empty_polygon
        nop                                       nop
clip_negative_y:
        nop                                       fcand vi01,0x104104
        nop                                       nop
        nop                                       ibeq vi01,vi00,clip_positive_y
        nop                                       nop
        max.xzw vf01,vf00,vf00xzw                 bal vi15,mesh_clip_polygon_plane
        subw.y vf01,vf00,vf00w                    nop
        nop                                       ibeq vi05,vi06,clip_empty_polygon
        nop                                       nop
clip_positive_y:
        nop                                       fcand vi01,0x208208
        nop                                       nop
        nop                                       ibeq vi01,vi00,clip_screen_begin
        nop                                       nop
        max.xzw vf01,vf00,vf00xzw                 bal vi15,mesh_clip_polygon_plane
        addw.y vf01,vf00,vf00w                    nop
        nop                                       ibeq vi05,vi06,clip_empty_polygon
        nop                                       nop
clip_screen_begin:
        nop                                       iadd vi09,vi00,vi00
        nop                                       iadd vi12,vi00,vi05
clip_screen_next:
        nop                                       lq.xyzw vf09,0(vi12)
        nop                                       lq.xyzw vf10,1(vi12)
        nop                                       lq.xyzw vf11,2(vi12)
        nop                                       lq.xyzw vf12,3(vi12)
        nop                                       div q,vf00w,vf12w
        miniz.w vf12,vf12,vf04z                   nop
        mulq.xyz vf09,vf09,q                      waitq
        mulq.xyzw vf12,vf12,q                     nop
        mula.xyzw acc,vf12,vf06                   nop
        ; I: native half-unit color rounding
        maddw[i].xyzw vf12,vf05,vf00w             loi 0.5
        addi.xyzw vf10,vf10,i                     nop
        addi.xyzw vf11,vf11,i                     nop
        ftoi0.xyzw vf10,vf10                      nop
        ftoi0.xyzw vf11,vf11                      nop
        nop                                       sqi.xyzw vf09,(vi12++)
        nop                                       sqi.xyzw vf10,(vi12++)
        nop                                       sqi.xyzw vf11,(vi12++)
        nop                                       sqi.xyzw vf12,(vi12++)
        nop                                       iaddiu vi09,vi09,1
        nop                                       ibne vi12,vi06,clip_screen_next
        nop                                       nop
        nop                                       b clip_restore_link
        nop                                       nop
clip_empty_polygon:
        nop                                       iadd vi09,vi00,vi00
        nop                                       iadd vi06,vi00,vi05
clip_restore_link:
        return_saved_micro_link
end_native_routine mesh_clip_project_polygon

; Walk flagged strips, copy each triangle into native scratch, clip/cull it and emit original GIF headers/vertices with XGKICK; preserve alternating winding and optional second material stream.
begin_native_routine mesh_emit_clipped_triangles
        nop                                       ilw.z vi01,packet_control_qword(vi04)
        nop                                       nop
        save_micro_link
        nop                                       ibeq vi01,vi00,triangle_restore_link
        nop                                       nop
        nop                                       iaddi vi02,vi00,-1
        nop                                       iaddi vi07,vi00,1
        nop                                       iadd vi10,vi04,vi10
        nop                                       iadd vi11,vi04,vi11
        nop                                       ibgtz vi08,triangle_optional_second_packet
        nop                                       nop
        nop                                       ibeq vi08,vi02,triangle_disable_winding
        nop                                       nop
        nop                                       b triangle_next
        nop                                       iaddi vi08,vi00,0
triangle_optional_second_packet:
        nop                                       b triangle_next
        nop                                       iadd vi08,vi04,vi08
triangle_disable_winding:
        nop                                       iaddi vi08,vi00,0
        nop                                       iaddi vi07,vi00,0
triangle_next:
        nop                                       ilw.w vi01,3(vi10)
        nop                                       iaddiu vi02,vi00,0x3000
        nop                                       iaddiu vi03,vi00,0x1000
        nop                                       nop
        nop                                       ibgez vi01,triangle_advance
        nop                                       iand vi02,vi01,vi02
        nop                                       nop
        nop                                       ibne vi02,vi03,triangle_advance
        nop                                       nop
        nop                                       iaddiu vi05,vi00,0x10
        nop                                       iaddiu vi06,vi05,12
        nop                                       iadd vi12,vi00,vi05
        nop                                       iaddi vi10,vi10,-12
triangle_copy_scratch:
        nop                                       iaddi vi10,vi10,4
        nop                                       lq.xyzw vf04,0(vi10)
        nop                                       lq.xyzw vf05,1(vi10)
        nop                                       lq.xyzw vf06,2(vi10)
        nop                                       lq.xyzw vf07,3(vi10)
        nop                                       sqi.xyzw vf04,(vi12++)
        nop                                       sqi.xyzw vf05,(vi12++)
        nop                                       sqi.xyzw vf06,(vi12++)
        nop                                       sqi.xyzw vf07,(vi12++)
        nop                                       nop
        nop                                       ibne vi12,vi06,triangle_copy_scratch
        nop                                       nop
        nop                                       bal vi15,mesh_clip_project_polygon
        nop                                       nop
        nop                                       ibeq vi05,vi06,triangle_advance
        nop                                       nop
        nop                                       bal vi15,mesh_cull_polygon
        nop                                       nop
        nop                                       ibeq vi05,vi06,triangle_advance
        nop                                       nop
        nop                                       iaddiu vi09,vi09,0x4000
        nop                                       iaddiu vi09,vi09,0x4000
        nop                                       isw.x vi09,15(vi00)
        nop                                       mtir vi01,vf03x
        nop                                       iadd vi02,vi04,vi01
        nop                                       iaddi vi02,vi02,2
        nop                                       xgkick vi02
        nop                                       lq.yz vf08,-1(vi02)
        nop                                       sq.yz vf08,15(vi00)
        nop                                       nop
        nop                                       nop
        nop                                       iaddi vi02,vi00,15
        nop                                       xgkick vi02
        nop                                       mtir vi01,vf03y
        nop                                       iadd vi02,vi04,vi01
        nop                                       ibeq vi01,vi00,triangle_restore_first_packet
        nop                                       iaddi vi02,vi02,2
        nop                                       xgkick vi02
        nop                                       lq.yz vf08,-1(vi02)
        nop                                       sq.yz vf08,15(vi00)
        nop                                       nop
        nop                                       nop
        nop                                       iaddi vi02,vi00,15
        nop                                       xgkick vi02
triangle_restore_first_packet:
        nop                                       mtir vi01,vf03x
        nop                                       iadd vi02,vi04,vi01
        nop                                       iaddi vi02,vi02,2
        nop                                       xgkick vi02
triangle_advance:
        nop                                       iaddi vi10,vi10,4
        nop                                       iaddi vi01,vi00,1
        nop                                       isub vi07,vi01,vi07
        nop                                       ibne vi10,vi11,triangle_next
        nop                                       nop
triangle_restore_link:
        return_saved_micro_link
end_native_routine mesh_emit_clipped_triangles

; Clip the qword-only outline against a signed plane. Q interpolation writes XYZ and retains the original W carrier supplied by native scratch.
begin_native_routine mesh_clip_outline_plane
        nop                                       lq.xyzw vf14,0(vi06)
        nop                                       iaddi vi11,vi06,0
        nop                                       iaddi vi12,vi11,0
        mul.xyzw vf15,vf01,vf14                   nop
        addaz.w acc,vf15,vf15z                    nop
        madday.w acc,vf00,vf15y                   nop
        maddx.w vf15,vf00,vf15x                   nop
        nop                                       sq.xyzw vf14,0(vi07)
        nop                                       nop
        nop                                       nop
        nop                                       fsand vi13,2
outline_plane_next_edge:
        max.xyzw vf17,vf15,vf15xyzw               iaddi vi14,vi13,0
        max.xyzw vf16,vf14,vf14xyzw               nop
        nop                                       lq.xyzw vf14,1(vi11)
        mul.xyzw vf15,vf01,vf14                   nop
        addaz.w acc,vf15,vf15z                    nop
        madday.w acc,vf00,vf15y                   nop
        maddx.w vf15,vf00,vf15x                   nop
        nop                                       nop
        nop                                       nop
        nop                                       nop
        nop                                       fsand vi13,2
        nop                                       nop
        nop                                       ibeq vi14,vi13,outline_plane_no_crossing
        nop                                       nop
        sub.w vf18,vf15,vf17                      nop
        nop                                       div q,vf15w,vf18w
        subq.w vf18,vf00,q                        waitq
        mulaq.xyz acc,vf16,q                      nop
        maddw.xyz vf19,vf14,vf18w                 nop
        nop                                       sqi.xyzw vf19,(vi12++)
outline_plane_no_crossing:
        nop                                       ibne vi13,vi00,outline_plane_advance
        nop                                       nop
        nop                                       sqi.xyzw vf14,(vi12++)
outline_plane_advance:
        nop                                       iaddi vi11,vi11,1
        nop                                       nop
        nop                                       ibne vi11,vi07,outline_plane_next_edge
        nop                                       nop
        nop                                       iaddi vi07,vi12,0
        nop                                       jr vi15
        nop                                       nop
end_native_routine mesh_clip_outline_plane

; Optional centroid/Manhattan angular ordering and insertion sort; clip four XY sides, project, emit the outline and patch the original packet end pointer.
begin_native_routine mesh_sort_clip_outline
        save_micro_link
        nop                                       ilw.z vi01,packet_control_qword(vi04)
        nop                                       nop
        nop                                       ibeq vi01,vi00,outline_restore_link
        nop                                       iadd vi05,vi05,vi04
        nop                                       iaddiu vi06,vi05,2
        nop                                       ilw.x vi07,0(vi05)
        nop                                       iadd vi07,vi07,vi04
        nop                                       isub vi03,vi07,vi06
        nop                                       iaddi vi01,vi03,-3
        nop                                       nop
        nop                                       ibltz vi01,outline_restore_link
        nop                                       nop
        nop                                       ibeq vi08,vi00,outline_emit_header
        sub.xyzw vf05,vf00,vf00                   nop
        nop                                       mfir.w vf03,vi03
        itof0.w vf03,vf03                         iaddi vi10,vi06,0
        nop                                       div q,vf00w,vf03w
outline_accumulate_centroid:
        nop                                       lqi.xy vf04,(vi10++)
        add.xy vf05,vf05,vf04                     nop
        nop                                       ibne vi10,vi07,outline_accumulate_centroid
        nop                                       nop
        mulq.xy vf05,vf05,q                       waitq
        sub.xyzw vf06,vf00,vf00                   iaddiu vi10,vi06,0
        add.w vf07,vf00,vf00                      nop
        add.w vf08,vf07,vf07                      nop
outline_assign_angle:
        nop                                       lqi.xyzw vf04,(vi10++)
        sub.xy vf03,vf04,vf05                     iaddiu vi03,vi00,0xc0
        nop                                       nop
        nop                                       nop
        nop                                       nop
        abs.xy vf09,vf03                          fmand vi03,vi03
        addx.y vf09,vf09,vf09x                    isubiu vi02,vi03,0x80
        nop                                       div q,vf03y,vf09y
        nop                                       waitq
        nop                                       ibeq vi03,vi00,outline_store_angle
        addq.w vf04,vf06,q                        nop
        nop                                       ibgez vi02,outline_store_angle
        subq.w vf04,vf07,q                        nop
        addq.w vf04,vf08,q                        nop
outline_store_angle:
        nop                                       ibne vi10,vi07,outline_assign_angle
        nop                                       sq.xyzw vf04,-1(vi10)
        nop                                       iaddiu vi10,vi06,1
outline_sort_next:
        nop                                       isubiu vi11,vi10,1
outline_insert_previous:
        nop                                       lq.xyzw vf10,0(vi11)
        nop                                       lq.xyzw vf11,1(vi11)
        sub.w vf00,vf11,vf10                      nop
        nop                                       nop
        nop                                       nop
        nop                                       nop
        nop                                       fsand vi03,2
        nop                                       nop
        nop                                       ibeq vi03,vi00,outline_insert_done
        nop                                       nop
        nop                                       sq.xyzw vf10,1(vi11)
        nop                                       sq.xyzw vf11,0(vi11)
        nop                                       ibne vi11,vi06,outline_insert_previous
        nop                                       isubiu vi11,vi11,1
outline_insert_done:
        nop                                       iaddiu vi10,vi10,1
        nop                                       nop
        nop                                       ibne vi10,vi07,outline_sort_next
        nop                                       nop
        sub.yw vf01,vf00,vf00                     nop
        maxw.xz vf01,vf00,vf00w                   nop
        nop                                       bal vi15,mesh_clip_outline_plane
        nop                                       nop
        nop                                       ibeq vi06,vi07,outline_update_end
        nop                                       nop
        subw.x vf01,vf00,vf00w                    nop
        nop                                       bal vi15,mesh_clip_outline_plane
        nop                                       nop
        nop                                       ibeq vi06,vi07,outline_update_end
        nop                                       nop
        sub.xw vf01,vf00,vf00                     nop
        maxw.yz vf01,vf00,vf00w                   nop
        nop                                       bal vi15,mesh_clip_outline_plane
        nop                                       nop
        nop                                       ibeq vi06,vi07,outline_update_end
        nop                                       nop
        subw.y vf01,vf00,vf00w                    nop
        nop                                       bal vi15,mesh_clip_outline_plane
        nop                                       nop
        nop                                       ibeq vi06,vi07,outline_update_end
        nop                                       nop
        nop                                       iaddi vi10,vi06,0
        nop                                       lq.xyzw vf13,0(vi00)
        nop                                       lq.xyzw vf12,1(vi00)
outline_project_next:
        nop                                       lqi.xyzw vf03,(vi10++)
        nop                                       div q,vf00w,vf03z
        mulq.xyz vf03,vf03,q                      waitq
        mula.xyz acc,vf03,vf13                    nop
        maddw.xyz vf03,vf12,vf00w                 nop
        sub.w vf03,vf03,vf03                      nop
        nop                                       ibne vi10,vi07,outline_project_next
        nop                                       sq.xyzw vf03,-1(vi10)
        nop                                       iadd vi08,vi08,vi04
        nop                                       xgkick vi08
outline_emit_header:
        nop                                       iadd vi09,vi09,vi04
        nop                                       lq.yzw vf03,0(vi09)
        nop                                       sq.yzw vf03,-1(vi06)
        nop                                       isub vi02,vi07,vi06
        nop                                       iaddiu vi02,vi02,0x4000
        nop                                       iaddiu vi02,vi02,0x4000
        nop                                       isw.x vi02,-1(vi06)
        nop                                       nop
        nop                                       nop
        nop                                       iaddi vi02,vi06,-1
        nop                                       xgkick vi02
outline_update_end:
        nop                                       isub vi01,vi07,vi04
        nop                                       isw.x vi01,0(vi05)
outline_restore_link:
        return_saved_micro_link
end_native_routine mesh_sort_clip_outline

; Convert and scale only the packet alpha W lane through the original whole-vector integer conversions; store the full original carrier qword.
begin_native_routine mesh_scale_packet_alpha
        nop                                       iadd vi05,vi05,vi04
        nop                                       lq.xyzw vf04,7(vi05)
        itof0.xyzw vf04,vf04                      nop
        mulx.w vf04,vf04,vf03x                    nop
        ftoi0.xyzw vf04,vf04                      nop
        nop                                       jr vi15
        nop                                       sq.xyzw vf04,7(vi05)
end_native_routine mesh_scale_packet_alpha

; Flip to opposite TOPS-relative buffer, invoke its pending instruction-index callback if nonzero, flip back, and restore the rotating native link stack. Real callback producers are three resume routines below.
begin_native_routine mesh_dispatch_previous
        save_micro_link
        nop                                       iaddiu vi01,vi00,0x24e
        nop                                       isub vi04,vi01,vi04
        nop                                       ilw.x vi01,packet_control_qword(vi04)
        nop                                       nop
        nop                                       nop
        nop                                       nop
        nop                                       ibeq vi01,vi00,previous_restore_current
        nop                                       nop
        nop                                       jalr vi15,vi01
        nop                                       nop
previous_restore_current:
        nop                                       iaddiu vi01,vi00,0x24e
        nop                                       isub vi04,vi01,vi04
        return_saved_micro_link
end_native_routine mesh_dispatch_previous

; Consume and clear the fixed qword15 W debug request; execute the original D flag pair when requested. This helper is preserved even though the bounded launch path does not call it.
begin_native_routine mesh_debug_acknowledge
        nop                                       ilw.w vi01,15(vi00)
        nop                                       isw.w vi00,15(vi00)
        nop                                       nop
        nop                                       nop
        nop                                       ibeq vi01,vi00,debug_acknowledge_done
        nop                                       nop
        nop[d]                                    nop
        nop                                       nop
debug_acknowledge_done:
        nop                                       jr vi15
        nop                                       nop
end_native_routine mesh_debug_acknowledge

; Cross cofactors, determinant, transpose and native Q reciprocal for a3x3 inverse, with original issue scheduling and lane masks.
begin_native_routine mesh_inverse_normal_matrix
        nop                                       lq.xyzw vf25,0(vi01)
        nop                                       lq.xyzw vf26,1(vi01)
        nop                                       lq.xyzw vf27,2(vi01)
        opmula.xyz acc,vf26,vf27                  nop
        opmsub.xyz vf29,vf27,vf26                 nop
        opmula.xyz acc,vf27,vf25                  nop
        opmsub.xyz vf30,vf25,vf27                 nop
        mul.xyz vf28,vf25,vf29                    nop
        opmula.xyz acc,vf25,vf26                  nop
        opmsub.xyz vf31,vf26,vf25                 nop
        mulax.w acc,vf00,vf28x                    nop
        madday.w acc,vf00,vf28y                   nop
        maddz.w vf28,vf00,vf28z                   nop
        nop                                       div q,vf00w,vf28w
        addx.y vf29,vf00,vf30x                    mr32.x vf30,vf29
        addy.z vf30,vf00,vf31y                    mr32.y vf31,vf30
        addx.z vf29,vf00,vf31x                    move.z vf28,vf29
        addz.x vf31,vf00,vf28z                    nop
        mulq.xyz vf29,vf29,q                      waitq
        mulq.xyz vf30,vf30,q                      nop
        mulq.xyz vf31,vf31,q                      nop
        nop                                       jr vi15
        nop                                       nop
end_native_routine mesh_inverse_normal_matrix

; Actual setup MSCAL immediate6C7 enters byte3638. E plus its real following NOP pair ends without inventing a return register.
begin_native_routine mesh_idle
        nop[e]                                    nop
        nop                                       nop
end_native_routine mesh_idle

; TOPS complement selects prior packet. Consume two native integer delay counters then XGKICK qword24 and end at the original E/delay pair.
begin_native_routine mesh_delay_and_kick
        nop                                       xtop vi01
        nop                                       iaddiu vi04,vi00,0x24e
        nop                                       isub vi04,vi04,vi01
        nop                                       ilw.x vi06,23(vi04)
        nop                                       ilw.y vi05,23(vi04)
delay_native_counter:
        nop                                       nop
        nop                                       ibne vi06,vi00,delay_native_counter
        nop                                       isubiu vi06,vi06,1
        nop                                       ibeq vi05,vi00,delay_emit_packet
        nop                                       isubiu vi05,vi05,1
        nop                                       b delay_native_counter
        nop                                       nop
delay_emit_packet:
        nop                                       iaddiu vi01,vi04,0x18
        nop                                       xgkick vi01
        nop                                       nop
        nop[e]                                    nop
        nop                                       nop
end_native_routine mesh_delay_and_kick

; Three public entry prefixes compose, restore or use current packet state; shared tail adjusts UV, skins channels, modulates material and chooses cubic/dynamic/projective shading before native kick and E.
begin_native_routine mesh_draw_primary
        nop                                       xtop vi01
        nop                                       iaddiu vi04,vi00,0x24e
        nop                                       isub vi04,vi04,vi01
        nop                                       bal vi15,mesh_dispatch_previous
        nop                                       nop
        ; Signed branch wraps architectural VU1 micro memory; symbolic target remains local.
        nop                                       bal vi15,mesh_compose_transform+VU1_micro_bytes
        nop                                       nop
        nop                                       ilw.x vi01,packet_flags_qword(vi04)
        nop                                       iaddiu vi02,vi00,2
        nop                                       iand vi02,vi02,vi01
        nop                                       nop
        nop                                       ibeq vi02,vi00,mesh_draw_primary_after_transform
        nop                                       nop
        ; Signed branch wraps architectural VU1 micro memory; symbolic target remains local.
        nop                                       bal vi15,mesh_prepare_light_basis+VU1_micro_bytes
        nop                                       nop
        nop                                       b mesh_draw_primary_after_transform
        nop                                       nop
mesh_draw_primary_restore:
; Genuine additional entry into this native body; no duplicate source span.
.local mesh_draw_primary_restore
        nop                                       xtop vi01
        nop                                       iaddiu vi04,vi00,0x24e
        nop                                       isub vi04,vi04,vi01
        nop                                       bal vi15,mesh_dispatch_previous
        nop                                       nop
        ; Signed branch wraps architectural VU1 micro memory; symbolic target remains local.
        nop                                       bal vi15,mesh_restore_previous_packet+VU1_micro_bytes
        nop                                       nop
        nop                                       b mesh_draw_primary_after_transform
        nop                                       nop
mesh_draw_primary_ready:
; Genuine additional entry into this native body; no duplicate source span.
.local mesh_draw_primary_ready
        nop                                       xtop vi01
        nop                                       iaddiu vi04,vi00,0x24e
        nop                                       isub vi04,vi04,vi01
        nop                                       bal vi15,mesh_dispatch_previous
        nop                                       nop
mesh_draw_primary_after_transform:
; Genuine additional entry into this native body; no duplicate source span.
.local mesh_draw_primary_after_transform
        nop                                       ilw.z vi05,primary_channels_qword(vi04)
        nop                                       ilw.x vi06,primary_vertices_qword(vi04)
        nop                                       ilw.z vi07,primary_vertices_qword(vi04)
        nop                                       lq.xyzw vf03,primary_gif_qword(vi04)
        nop                                       ibeq vi05,vi00,primary_vertex_channels
        nop                                       ilw.w vi08,primary_material_qword(vi04)
        ; Signed branch wraps architectural VU1 micro memory; symbolic target remains local.
        nop                                       bal vi15,mesh_adjust_uv+VU1_micro_bytes
        nop                                       nop
primary_vertex_channels:
        nop                                       ilw.z vi07,primary_material_qword(vi04)
        nop                                       ilw.x vi01,packet_flags_qword(vi04)
        nop                                       nop
        nop                                       nop
        nop                                       ibeq vi07,vi00,primary_material_gain
        nop                                       iaddiu vi02,vi00,0x10
        nop                                       iand vi02,vi01,vi02
        nop                                       nop
        nop                                       ibne vi02,vi00,primary_skin_positions
        nop                                       nop
        nop                                       iaddiu vi02,vi00,0x20
        nop                                       iand vi02,vi01,vi02
        nop                                       nop
        nop                                       ibne vi02,vi00,primary_skin_normals
        nop                                       nop
        nop                                       iaddiu vi02,vi00,0x40
        nop                                       iand vi02,vi01,vi02
        nop                                       nop
        nop                                       ibeq vi02,vi00,primary_material_gain
        nop                                       nop
        nop                                       ilw.x vi05,primary_vertices_qword(vi04)
        ; Signed branch wraps architectural VU1 micro memory; symbolic target remains local.
        nop                                       bal vi15,mesh_add_matrix_channels+VU1_micro_bytes
        nop                                       ilw.z vi06,primary_vertices_qword(vi04)
        nop                                       ilw.z vi07,secondary_material_qword(vi04)
        nop                                       ilw.x vi05,secondary_vertices_qword(vi04)
        ; Signed branch wraps architectural VU1 micro memory; symbolic target remains local.
        nop                                       bal vi15,mesh_add_matrix_channels+VU1_micro_bytes
        nop                                       ilw.z vi06,secondary_vertices_qword(vi04)
        nop                                       b primary_material_gain
        nop                                       nop
primary_skin_positions:
        nop                                       ilw.x vi05,primary_channels_qword(vi04)
        nop                                       bal vi15,mesh_skin_positions
        nop                                       ilw.y vi06,primary_channels_qword(vi04)
        nop                                       ilw.z vi07,secondary_material_qword(vi04)
        nop                                       ilw.x vi05,secondary_channels_qword(vi04)
        nop                                       bal vi15,mesh_skin_positions
        nop                                       ilw.y vi06,secondary_channels_qword(vi04)
        nop                                       b primary_material_gain
        nop                                       nop
primary_skin_normals:
        nop                                       ilw.x vi05,primary_channels_qword(vi04)
        nop                                       bal vi15,mesh_skin_normals_positions
        nop                                       ilw.y vi06,primary_channels_qword(vi04)
        nop                                       ilw.z vi07,secondary_material_qword(vi04)
        nop                                       ilw.x vi05,secondary_channels_qword(vi04)
        nop                                       bal vi15,mesh_skin_normals_positions
        nop                                       ilw.y vi06,secondary_channels_qword(vi04)
primary_material_gain:
        nop                                       ilw.w vi07,primary_channels_qword(vi04)
        nop                                       ilw.y vi05,primary_channels_qword(vi04)
        nop                                       ilw.y vi06,primary_material_qword(vi04)
        nop                                       nop
        nop                                       ibeq vi07,vi00,primary_choose_shader
        nop                                       nop
        nop                                       bal vi15,mesh_modulate_material
        nop                                       nop
        nop                                       ilw.w vi07,secondary_channels_qword(vi04)
        nop                                       ilw.y vi05,secondary_channels_qword(vi04)
        nop                                       bal vi15,mesh_modulate_material
        nop                                       ilw.y vi06,secondary_material_qword(vi04)
primary_choose_shader:
        nop                                       ilw.x vi01,packet_flags_qword(vi04)
        nop                                       iaddiu vi02,vi00,2
        nop                                       iand vi02,vi02,vi01
        nop                                       nop
        nop                                       ibeq vi02,vi00,primary_choose_dynamic_shader
        nop                                       nop
        nop                                       ilw.x vi05,primary_channels_qword(vi04)
        nop                                       ilw.y vi06,primary_channels_qword(vi04)
        ; Signed branch wraps architectural VU1 micro memory; symbolic target remains local.
        nop                                       bal vi15,mesh_shade_cubic+VU1_micro_bytes
        nop                                       ilw.x vi07,primary_material_qword(vi04)
        nop                                       bal vi15,mesh_dispatch_previous
        nop                                       nop
        nop                                       ilw.x vi05,secondary_channels_qword(vi04)
        nop                                       ilw.y vi06,secondary_channels_qword(vi04)
        ; Signed branch wraps architectural VU1 micro memory; symbolic target remains local.
        nop                                       bal vi15,mesh_shade_cubic+VU1_micro_bytes
        nop                                       ilw.x vi07,secondary_material_qword(vi04)
        nop                                       bal vi15,mesh_dispatch_previous
        nop                                       nop
        nop                                       ilw.x vi01,primary_gif_qword(vi04)
        nop                                       bal vi15,mesh_kick_packet_pair
        nop                                       iaddiu vi02,vi00,0
        nop[e]                                    nop
        nop                                       nop
primary_choose_dynamic_shader:
        nop                                       ilw.x vi01,packet_flags_qword(vi04)
        nop                                       iaddiu vi02,vi00,0x800
        nop                                       iand vi02,vi02,vi01
        nop                                       nop
        nop                                       ibeq vi02,vi00,primary_project
        nop                                       nop
        nop                                       ilw.x vi05,primary_channels_qword(vi04)
        nop                                       ilw.y vi06,primary_channels_qword(vi04)
        ; Signed branch wraps architectural VU1 micro memory; symbolic target remains local.
        nop                                       bal vi15,mesh_shade_dynamic+VU1_micro_bytes
        nop                                       ilw.x vi07,primary_material_qword(vi04)
        nop                                       bal vi15,mesh_dispatch_previous
        nop                                       nop
        nop                                       ilw.x vi05,secondary_channels_qword(vi04)
        nop                                       ilw.y vi06,secondary_channels_qword(vi04)
        ; Signed branch wraps architectural VU1 micro memory; symbolic target remains local.
        nop                                       bal vi15,mesh_shade_dynamic+VU1_micro_bytes
        nop                                       ilw.x vi07,secondary_material_qword(vi04)
        nop                                       bal vi15,mesh_dispatch_previous
        nop                                       nop
        nop                                       ilw.x vi01,primary_gif_qword(vi04)
        nop                                       bal vi15,mesh_kick_packet_pair
        nop                                       iaddiu vi02,vi00,0
        nop[e]                                    nop
        nop                                       nop
primary_project:
        nop                                       ilw.x vi08,primary_vertices_qword(vi04)
        nop                                       ilw.y vi09,primary_vertices_qword(vi04)
        nop                                       ilw.w vi10,primary_vertices_qword(vi04)
        ; Signed branch wraps architectural VU1 micro memory; symbolic target remains local.
        nop                                       bal vi15,mesh_project_vertices+VU1_micro_bytes
        nop                                       iaddi vi11,vi00,1
        nop                                       bal vi15,mesh_dispatch_previous
        nop                                       nop
        nop                                       ilw.z vi09,primary_vertices_qword(vi04)
        nop                                       iadd vi09,vi04,vi09
        nop                                       nop
        nop                                       ibeq vi07,vi09,primary_finish_projection
        nop                                       nop
        ; Signed branch wraps architectural VU1 micro memory; symbolic target remains local.
        nop                                       bal vi15,mesh_project_vertices_continue+VU1_micro_bytes
        nop                                       iadd vi08,vi07,vi00
primary_finish_projection:
        nop                                       bal vi15,mesh_dispatch_previous
        nop                                       nop
        nop                                       ilw.x vi01,primary_gif_qword(vi04)
        nop                                       bal vi15,mesh_kick_packet_pair
        nop                                       ilw.x vi02,primary_vertices_qword(vi04)
        nop[e]                                    nop
        nop                                       nop
end_native_routine mesh_draw_primary

; Actual direct TOPS entry handles secondary channels, shared primary packet kicks, clip continuation and installs the first pending resume callback in header12.X.
begin_native_routine mesh_draw_secondary
        nop                                       xtop vi04
        nop                                       ilw.z vi05,secondary_channels_qword(vi04)
        nop                                       ilw.x vi06,secondary_vertices_qword(vi04)
        nop                                       ilw.z vi07,secondary_vertices_qword(vi04)
        nop                                       lq.xyzw vf03,secondary_gif_qword(vi04)
        nop                                       ibeq vi05,vi00,secondary_choose_projection
        nop                                       ilw.w vi08,secondary_material_qword(vi04)
        ; Signed branch wraps architectural VU1 micro memory; symbolic target remains local.
        nop                                       bal vi15,mesh_adjust_uv+VU1_micro_bytes
        nop                                       nop
secondary_choose_projection:
        nop                                       ilw.x vi01,packet_flags_qword(vi04)
        nop                                       iaddiu vi02,vi00,0x802
        nop                                       iand vi02,vi02,vi01
        nop                                       nop
        nop                                       ibeq vi02,vi00,secondary_project
        nop                                       nop
        nop                                       ilw.x vi08,primary_vertices_qword(vi04)
        nop                                       ilw.z vi09,primary_vertices_qword(vi04)
        nop                                       ilw.w vi10,primary_vertices_qword(vi04)
        ; Signed branch wraps architectural VU1 micro memory; symbolic target remains local.
        nop                                       bal vi15,mesh_project_vertices+VU1_micro_bytes
        nop                                       iaddi vi11,vi00,1
        nop                                       ilw.x vi01,primary_gif_qword(vi04)
        nop                                       bal vi15,mesh_kick_packet_pair
        nop                                       ilw.x vi02,primary_vertices_qword(vi04)
secondary_project:
        nop                                       ilw.x vi08,secondary_vertices_qword(vi04)
        nop                                       ilw.y vi09,secondary_vertices_qword(vi04)
        nop                                       ilw.w vi10,secondary_vertices_qword(vi04)
        ; Signed branch wraps architectural VU1 micro memory; symbolic target remains local.
        nop                                       bal vi15,mesh_project_vertices+VU1_micro_bytes
        nop                                       iaddi vi11,vi00,1
        nop                                       ilw.y vi01,primary_gif_qword(vi04)
        nop                                       bal vi15,mesh_kick_packet_pair
        nop                                       ilw.x vi02,primary_vertices_qword(vi04)
        nop                                       ilw.z vi01,primary_gif_qword(vi04)
        nop                                       bal vi15,mesh_kick_packet_pair
        nop                                       ilw.x vi02,primary_vertices_qword(vi04)
        nop                                       ilw.z vi09,secondary_vertices_qword(vi04)
        nop                                       iadd vi09,vi09,vi04
        nop                                       nop
        nop                                       ibeq vi07,vi09,secondary_clip_and_resume
        nop                                       nop
        ; Signed branch wraps architectural VU1 micro memory; symbolic target remains local.
        nop                                       bal vi15,mesh_project_vertices_continue+VU1_micro_bytes
        nop                                       iadd vi08,vi07,vi00
secondary_clip_and_resume:
        nop                                       iadd vi08,vi00,vi00
        nop                                       ilw.x vi10,primary_vertices_qword(vi04)
        nop                                       ilw.z vi11,primary_vertices_qword(vi04)
        nop                                       bal vi15,mesh_emit_clipped_triangles
        nop                                       lq.xyzw vf03,primary_gif_qword(vi04)
        nop                                       iaddiu vi01,vi00,(mesh_resume_secondary_first-mesh_program_begin)
        nop                                       isw.x vi01,packet_control_qword(vi04)
        nop[e]                                    nop
        nop                                       nop
end_native_routine mesh_draw_secondary

; Kick first secondary stream, then install instruction index for the following pair resume. Its VI15 link is saved in the native VF2 ring.
begin_native_routine mesh_resume_secondary_first
        save_micro_link
        nop                                       ilw.x vi01,secondary_gif_qword(vi04)
        nop                                       bal vi15,mesh_kick_packet_pair
        nop                                       ilw.x vi02,secondary_vertices_qword(vi04)
        nop                                       iaddiu vi01,vi00,(mesh_resume_secondary_pair-mesh_program_begin)
        nop                                       isw.x vi01,packet_control_qword(vi04)
        return_saved_micro_link
end_native_routine mesh_resume_secondary_first

; Kick two secondary material streams, then install the final clip resume callback. Preserve every original link/branch delay pair.
begin_native_routine mesh_resume_secondary_pair
        save_micro_link
        nop                                       ilw.y vi01,secondary_gif_qword(vi04)
        nop                                       bal vi15,mesh_kick_packet_pair
        nop                                       ilw.x vi02,secondary_vertices_qword(vi04)
        nop                                       ilw.z vi01,secondary_gif_qword(vi04)
        nop                                       bal vi15,mesh_kick_packet_pair
        nop                                       ilw.x vi02,secondary_vertices_qword(vi04)
        nop                                       iaddiu vi01,vi00,(mesh_resume_secondary_clip-mesh_program_begin)
        nop                                       isw.x vi01,packet_control_qword(vi04)
        return_saved_micro_link
end_native_routine mesh_resume_secondary_pair

; Emit secondary clipped triangles and clear the pending callback. No initialized frame memory is claimed.
begin_native_routine mesh_resume_secondary_clip
        save_micro_link
        nop                                       iadd vi08,vi00,vi00
        nop                                       ilw.x vi10,secondary_vertices_qword(vi04)
        nop                                       ilw.z vi11,secondary_vertices_qword(vi04)
        nop                                       bal vi15,mesh_emit_clipped_triangles
        nop                                       lq.xyzw vf03,secondary_gif_qword(vi04)
        nop                                       isw.x vi00,packet_control_qword(vi04)
        return_saved_micro_link
end_native_routine mesh_resume_secondary_clip

; TOPS complement, previous callback dispatch and composed model-view matrix, then tail branch into the shared primary projection path.
begin_native_routine mesh_draw_fast_transform
        nop                                       xtop vi01
        nop                                       iaddiu vi04,vi00,0x24e
        nop                                       isub vi04,vi04,vi01
        nop                                       bal vi15,mesh_dispatch_previous
        nop                                       nop
        ; Signed branch wraps architectural VU1 micro memory; symbolic target remains local.
        nop                                       bal vi15,mesh_compose_transform+VU1_micro_bytes
        nop                                       nop
        nop                                       b primary_project
        nop                                       nop
end_native_routine mesh_draw_fast_transform

; TOPS complement, previous callback dispatch and previous packet restore, then the same shared projection path.
begin_native_routine mesh_draw_fast_restore
        nop                                       xtop vi01
        nop                                       iaddiu vi04,vi00,0x24e
        nop                                       isub vi04,vi04,vi01
        nop                                       bal vi15,mesh_dispatch_previous
        nop                                       nop
        ; Signed branch wraps architectural VU1 micro memory; symbolic target remains local.
        nop                                       bal vi15,mesh_restore_previous_packet+VU1_micro_bytes
        nop                                       nop
        nop                                       b primary_project
        nop                                       nop
end_native_routine mesh_draw_fast_restore

; TOPS complement and previous callback dispatch, then tail into shared primary projection without rebuilding the transform.
begin_native_routine mesh_draw_fast_ready
        nop                                       xtop vi01
        nop                                       iaddiu vi04,vi00,0x24e
        nop                                       isub vi04,vi04,vi01
        nop                                       bal vi15,mesh_dispatch_previous
        nop                                       nop
        nop                                       b primary_project
        nop                                       nop
end_native_routine mesh_draw_fast_ready

; Native tail branch enters shared secondary projection; its real delay supplies XTOP VI4.
begin_native_routine mesh_draw_secondary_ready
        nop                                       b secondary_project
        nop                                       xtop vi04
end_native_routine mesh_draw_secondary_ready

; Actual teardown MSCAL immediate7F2 enters byte3F90. Dispatch three original pending phases and end at the last complete E/delay pair.
begin_native_routine mesh_flush_pending
