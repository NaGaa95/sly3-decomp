        mulax.xyz acc,vf03,vf19x                  lqi.xyzw vf20,(vi07++)
        madday.xyz acc,vf04,vf19y                 nop
        maddaz.xyz acc,vf05,vf19z                 nop
        maddw.xyz vf21,vf06,vf00w                 nop
        ftoi4.xyz vf25,vf25                       nop
