        nop                                       nop
        itof12.xy vf04,vf04                       ibeq vi01,vi00,uv_adjust_done
        nop                                       nop
        nop                                       lq.xy vf06,0(vi06)
        itof12.xy vf06,vf06                       lq.xy vf07,4(vi06)
        itof12.xy vf07,vf07                       lq.xy vf08,8(vi06)
        add.xy vf06,vf06,vf04                     nop
        itof12.xy vf08,vf08                       lq.xy vf09,12(vi06)
        add.xy vf07,vf07,vf04                     nop
        ftoi12.xy vf06,vf06                       nop
uv_pipeline_next:
        nop                                       iaddiu vi06,vi06,4
        itof12.xy vf09,vf09                       lq.xy vf05,12(vi06)
        add.xy vf08,vf08,vf04                     ibeq vi06,vi07,uv_adjust_done
        ftoi12.xy vf07,vf07                       sq.xy vf06,-4(vi06)
        nop                                       iaddiu vi06,vi06,4
        itof12.xy vf05,vf05                       lq.xy vf06,12(vi06)
        add.xy vf09,vf09,vf04                     ibeq vi06,vi07,uv_adjust_done
        ftoi12.xy vf08,vf08                       sq.xy vf07,-4(vi06)
        nop                                       iaddiu vi06,vi06,4
        itof12.xy vf06,vf06                       lq.xy vf07,12(vi06)
        add.xy vf05,vf05,vf04                     ibeq vi06,vi07,uv_adjust_done
        ftoi12.xy vf09,vf09                       sq.xy vf08,-4(vi06)
        nop                                       iaddiu vi06,vi06,4
        itof12.xy vf07,vf07                       lq.xy vf08,12(vi06)
        add.xy vf06,vf06,vf04                     ibeq vi06,vi07,uv_adjust_done
        ftoi12.xy vf05,vf05                       sq.xy vf09,-4(vi06)
        nop                                       iaddiu vi06,vi06,4
        itof12.xy vf08,vf08                       lq.xy vf09,12(vi06)
        add.xy vf07,vf07,vf04                     ibne vi06,vi07,uv_pipeline_next
        ftoi12.xy vf06,vf06                       sq.xy vf05,-4(vi06)
uv_adjust_done:
        nop                                       jr vi15
        nop                                       nop
