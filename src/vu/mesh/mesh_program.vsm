        addi.w vf10,vf10,i                        nop
        ftoi0.w vf10,vf10                         nop
        nop                                       sq.w vf10,1(vi06)
material_modulate_rgb_alpha:
        nop                                       ibne vi08,vi00,material_next_duplicate
        nop                                       lq.w vf10,1(vi05)
        nop                                       lq.xyz vf11,2(vi05)
        itof0.w vf10,vf10                         nop
        itof0.xyz vf11,vf11                       nop
        mulx.w vf10,vf10,vf07x                    nop
        ; I: native half-unit RGB rounding
        mulx[i].xyz vf11,vf11,vf07x               loi 0.5
        addi.w vf10,vf10,i                        nop
        addi.xyz vf11,vf11,i                      nop
        ftoi0.w vf10,vf10                         nop
        ftoi0.xyz vf11,vf11                       nop
        nop                                       sq.w vf10,1(vi05)
        nop                                       sq.xyz vf11,2(vi05)
material_next_duplicate:
