        clipw.xyz vf29,vf29                       nop
        clipw.xyz vf30,vf30                       ibne vi01,vi00,triangle_reject
        nop                                       fcor vi01,0xfefbef
        nop                                       nop
        nop                                       ibne vi01,vi00,triangle_reject
        nop                                       fcor vi01,0xff7df7
        nop                                       nop
        nop                                       ibne vi01,vi00,triangle_reject
        nop                                       fcor vi01,0xffbefb
        nop                                       nop
        nop                                       ibne vi01,vi00,triangle_reject
        nop                                       fcor vi01,0xffdf7d
        nop                                       nop
        nop                                       ibne vi01,vi00,triangle_reject
        nop                                       fcor vi01,0xffefbe
        nop                                       nop
        nop                                       ibne vi01,vi00,triangle_reject
        nop                                       iaddi vi01,vi00,1
        addy.w vf27,vf27,vf04y                    jr vi14
        nop                                       isw.z vi01,packet_control_qword(vi04)
triangle_reject:
        addx.w vf27,vf27,vf04x                    jr vi14
        nop                                       nop
triangle_already_disabled:
        nop                                       jr vi14
        nop                                       nop
end_native_routine mesh_classify_triangle

; Copy linked UV carriers then add the packet fixed12 XY offset to the four-qword vertex stream; native pipelined end slots stay intact.
begin_native_routine mesh_adjust_uv
        nop                                       iadd vi05,vi05,vi04
        sub.w vf03,vf00,vf00                      ilw.z vi09,0(vi05)
        nop                                       nop
        nop                                       nop
        nop                                       nop
