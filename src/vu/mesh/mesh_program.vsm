; Sly3 USA family376118843: complete native VU1 mesh processing overlay.
; Native algorithm source: packed/fixed vertex channels, billboard/model-view
; composition, weighted skinning, cubic/dynamic light shaders, polygon clipping
; and original pipelined GIF emission. No original words or input binary included.
; VI/VF operands are the real VU hardware registers; ACC/Q/P/I/flags and issue
; slots remain architectural operations, not host IEEE approximations.
; Concrete stock geometry + final indirect DMA launch still require separate
; input proof. This private full-program candidate carries ZERO admitted credit.
.ifdef VU_NATIVE_STANDALONE
.vu
.align 3
.endif
.equ VU1_micro_bytes,16384
.equ buffer_base_sum_qwords,0x24e
.equ packet_control_qword,12
.equ packet_flags_qword,13
.equ packet_matrices_qword,14
.equ primary_vertices_qword,15
.equ primary_gif_qword,16
.equ primary_channels_qword,17
.equ primary_material_qword,18
.equ secondary_vertices_qword,19
.equ secondary_gif_qword,20
.equ secondary_channels_qword,21
.equ secondary_material_qword,22

.macro begin_native_routine name
.local \name
.ifdef VU_NATIVE_STANDALONE
.type \name,@function
.endif
\name:
.endm
.macro end_native_routine name
.ifdef VU_NATIVE_STANDALONE
.size \name,.-\name
.endif
.endm

; Compose one homogeneous vector from four columns, preserving the original
; separate multiply/accumulate rounding and each upper issue slot.
.macro affine_xyzw result,c0,c1,c2,c3,point
        mulax.xyzw acc,\c0,\point\()x       nop
        madday.xyzw acc,\c1,\point\()y      nop
        maddaz.xyzw acc,\c2,\point\()z      nop
        maddw.xyzw \result,\c3,\point\()w   nop
.endm
; Linear XYZ transform. W is preserved exactly by the native destination mask.
.macro linear_xyz result,c0,c1,c2,point
        mulax.xyz acc,\c0,\point\()x        nop
        madday.xyz acc,\c1,\point\()y       nop
        maddz.xyz \result,\c2,\point\()z    nop
.endm
; Dot product with the original reduction order. Other result lanes survive.
.macro dot_xyz_x result,left,right
        mul.xyz \result,\left,\right      nop
        addy.x \result,\result,\result\()y nop
        addz.x \result,\result,\result\()z nop
.endm
; Native link nesting rotates the VF2 four-lane carrier. Restore's final rotate
; is the REAL JR delay pair, and is not moved ahead of the return.
.macro save_micro_link
        nop                         mr32.xyzw vf02,vf02
        nop                         mfir.x vf02,vi15
.endm
.macro return_saved_micro_link
        nop                         mtir vi15,vf02x
        nop                         mr32.xyzw vf02,vf02
        nop                         mr32.xyzw vf02,vf02
        nop                         jr vi15
        nop                         mr32.xyzw vf02,vf02
.endm

.global mesh_program_begin
mesh_program_begin:

; Compose packet matrix with the absolute scene view matrix. Flags select camera/axis billboard bases; optional scale and translation preserve native W lanes.
begin_native_routine mesh_compose_transform
        nop                                       ilw.x vi05,packet_flags_qword(vi04)
        nop                                       iaddiu vi02,vi00,0x1700
        nop                                       lq.xyzw vf03,0(vi04)
        nop                                       lq.xyzw vf04,1(vi04)
        nop                                       lq.xyzw vf05,2(vi04)
        nop                                       lq.xyzw vf06,3(vi04)
        nop                                       lq.xyzw vf07,3(vi00)
        nop                                       lq.xyzw vf08,4(vi00)
        nop                                       iand vi01,vi05,vi02
        nop                                       lq.xyzw vf09,5(vi00)
        nop                                       ibeq vi01,vi00,transform_apply_local_scale
        nop                                       lq.xyzw vf10,6(vi00)
        nop                                       eleng p,vf03
        nop                                       eleng p,vf04
        nop                                       mfp.x vf22,p
        nop                                       eleng p,vf05
        nop                                       mfp.y vf22,p
        nop                                       waitp
        nop                                       mfp.z vf22,p
        nop                                       iaddiu vi02,vi00,0x100
        nop                                       iaddiu vi03,vi00,0x200
        nop                                       ibeq vi01,vi02,transform_camera_facing
        nop                                       lq.xyzw vf15,10(vi00)
        nop                                       iaddiu vi02,vi00,0x400
        nop                                       ibeq vi01,vi03,transform_planar_camera_position
        nop                                       nop
        nop                                       ibeq vi01,vi02,transform_axis_billboard
        nop                                       nop
        sub.z vf03,vf00,vf00                      nop
        nop                                       erleng p,vf03
        nop                                       waitp
        nop                                       mfp.x vf22,p
        mulx.xyz vf03,vf03,vf22x                  nop
        sub.xy vf05,vf00,vf00                     nop
        addw.z vf05,vf00,vf00w                    nop
        opmula.xyz acc,vf05,vf03                  nop
        opmsub.xyz vf04,vf03,vf05                 nop
        nop                                       erleng p,vf04
        nop                                       waitp
        nop                                       mfp.y vf22,p
        muly.xyz vf04,vf04,vf22y                  nop
        nop                                       lq.xyzw vf24,0(vi04)
        dot_xyz_x vf23,vf24,vf03
        abs.x vf23,vf23                           nop
        nop                                       b transform_apply_local_scale
        mulx.xyz vf03,vf03,vf23x                  nop
transform_axis_billboard:
        ; I: half scale for axis billboard
        addy[i].x vf17,vf22,vf22y                 loi 0.5
        addi.xyz vf01,vf00,i                      nop
        sub.yz vf03,vf00,vf00                     move.z vf05,vf22
        sub.xz vf04,vf00,vf00                     nop
        sub.xy vf05,vf00,vf00                     nop
        mulx.x vf03,vf01,vf17x                    b transform_apply_local_scale
        mulx.y vf04,vf01,vf17x                    nop
transform_planar_camera_position:
        nop                                       move.z vf15,vf06
transform_camera_facing:
        sub.xyw vf18,vf00,vf00                    nop
        addw.z vf18,vf00,vf00w                    nop
        sub.xyz vf16,vf15,vf06                    nop
        nop                                       erleng p,vf16
        nop                                       waitp
        nop                                       mfp.w vf17,p
        mulw.xyz vf19,vf16,vf17w                  nop
        opmula.xyz acc,vf18,vf16                  nop
        opmsub.xyz vf20,vf16,vf18                 nop
        nop                                       erleng p,vf20
        nop                                       waitp
        nop                                       mfp.w vf17,p
        mulw.xyz vf20,vf20,vf17w                  nop
        opmula.xyz acc,vf19,vf20                  nop
        opmsub.xyz vf21,vf20,vf19                 nop
        mulx.xyz vf03,vf19,vf22x                  nop
        muly.xyz vf04,vf20,vf22y                  nop
        mulz.xyz vf05,vf21,vf22z                  nop
transform_apply_local_scale:
        nop                                       iaddiu vi02,vi00,0x2000
        nop                                       iand vi01,vi05,vi02
        nop                                       lq.xyzw vf26,11(vi04)
        nop                                       ibeq vi01,vi00,transform_compose_view
        nop                                       lq.xyzw vf25,10(vi04)
        mulax.xyz acc,vf03,vf26x                  nop
        madday.xyz acc,vf04,vf26y                 nop
        maddaz.xyz acc,vf05,vf26z                 nop
        mulx.xyz vf03,vf03,vf25x                  nop
        muly.xyz vf04,vf04,vf25y                  nop
        mulz.xyz vf05,vf05,vf25z                  nop
        maddw.xyz vf06,vf06,vf00w                 nop
transform_compose_view:
        affine_xyzw vf11,vf07,vf08,vf09,vf10,vf03
        affine_xyzw vf12,vf07,vf08,vf09,vf10,vf04
        affine_xyzw vf13,vf07,vf08,vf09,vf10,vf05
        mulax.xyzw acc,vf07,vf06x                 nop
        madday.xyzw acc,vf08,vf06y                sq.xyzw vf11,4(vi04)
        maddaz.xyzw acc,vf09,vf06z                sq.xyzw vf12,5(vi04)
        maddw.xyzw vf14,vf10,vf06w                sq.xyzw vf13,6(vi04)
        nop                                       jr vi15
        nop                                       sq.xyzw vf14,7(vi04)
end_native_routine mesh_compose_transform

; Rotate/save the actual VI15 link in VF2; derive inverse normal basis, attenuate four light records, transpose carrier/color rows and build cubic shader coefficients.
begin_native_routine mesh_prepare_light_basis
        save_micro_link
        nop                                       ilw.x vi07,packet_matrices_qword(vi04)
        nop                                       ilw.w vi08,packet_flags_qword(vi04)
        ; Signed branch wraps architectural VU1 micro memory; symbolic target remains local.
        nop                                       bal vi15,mesh_inverse_normal_matrix-VU1_micro_bytes
        nop                                       iaddiu vi01,vi04,0
        nop                                       iaddiu vi05,vi04,0x17
        nop                                       iaddiu vi06,vi04,0x23
        nop                                       iadd vi01,vi08,vi04
        nop                                       ibne vi07,vi00,light_basis_next_record
        nop                                       lq.xyzw vf05,3(vi01)
        nop                                       lq.xyzw vf05,3(vi04)
light_basis_next_record:
        nop                                       ilw.x vi09,0(vi05)
        nop                                       lq.xyzw vf03,0(vi05)
        nop                                       ibltz vi09,light_basis_transpose_coefficients
        nop                                       lq.xyzw vf04,2(vi05)
        nop                                       nop
        nop                                       ibeq vi09,vi00,light_basis_transform_direction
        nop                                       nop
        sub.xyz vf04,vf05,vf04                    nop
        nop                                       eleng p,vf04
        nop                                       waitp
        nop                                       mfp.x vf06,p
        addax.w acc,vf03,vf00x                    nop
        maddx.w vf06,vf04,vf06x                   nop
        miniw.w vf06,vf06,vf00w                   nop
        maxx.w vf06,vf06,vf00x                    nop
        mulw.yz vf03,vf03,vf06w                   nop
        nop                                       sq.xyzw vf03,0(vi05)
light_basis_transform_direction:
        linear_xyz vf04,vf29,vf30,vf31,vf04
        nop                                       erleng p,vf04
        nop                                       waitp
        nop                                       mfp.x vf06,p
        mulx.xyz vf04,vf04,vf06x                  nop
        nop                                       sq.xyzw vf04,2(vi05)
        nop                                       iaddi vi05,vi05,3
        nop                                       nop
        nop                                       ibne vi05,vi06,light_basis_next_record
        nop                                       nop
light_basis_transpose_coefficients:
        nop                                       lq.xyzw vf08,25(vi04)
        nop                                       lq.xyzw vf09,28(vi04)
        nop                                       lq.xyzw vf10,31(vi04)
        nop                                       lq.xyzw vf11,34(vi04)
        nop                                       lq.xyzw vf12,24(vi04)
        nop                                       lq.xyzw vf13,27(vi04)
        nop                                       lq.xyzw vf14,30(vi04)
        nop                                       lq.xyzw vf15,33(vi04)
        nop                                       lq.xyzw vf16,23(vi04)
        nop                                       lq.xyzw vf17,26(vi04)
        nop                                       lq.xyzw vf18,29(vi04)
        nop                                       lq.xyzw vf19,32(vi04)
        mulay.xyzw acc,vf12,vf16y                 nop
        madday.xyzw acc,vf13,vf17y                nop
        madday.xyzw acc,vf14,vf18y                nop
        maddy.xyzw vf20,vf15,vf19y                nop
        mulz.xyzw vf12,vf12,vf16z                 nop
        mulz.xyzw vf13,vf13,vf17z                 nop
        mulz.xyzw vf14,vf14,vf18z                 nop
        mulz.xyzw vf15,vf15,vf19z                 nop
        sub.xyzw vf21,vf00,vf00                   nop
        suby.z vf06,vf00,vf16y                    nop
        nop                                       div q,vf06z,vf16z
        addq.x vf21,vf21,q                        waitq
        suby.z vf06,vf00,vf17y                    nop
        nop                                       div q,vf06z,vf17z
        addq.y vf21,vf21,q                        waitq
        suby.z vf06,vf00,vf18y                    nop
        nop                                       div q,vf06z,vf18z
        addq.z vf21,vf21,q                        waitq
        suby.z vf06,vf00,vf19y                    nop
        nop                                       div q,vf06z,vf19z
        addq.w vf21,vf21,q                        waitq
        ; I: signed normal/color normalization1/127
        nop[i]                                    loi 0.0078740157186985016
        muli.xyzw vf08,vf08,i                     nop
        muli.xyzw vf09,vf09,i                     nop
        muli.xyzw vf10,vf10,i                     nop
        muli.xyzw vf11,vf11,i                     nop
        addx.y vf08,vf00,vf09x                    mr32.x vf06,vf08
        addy.z vf09,vf00,vf10y                    mr32.y vf06,vf09
        mulz.w vf10,vf00,vf11z                    mr32.z vf06,vf10
        addw.x vf11,vf00,vf08w                    mr32.w vf06,vf11
        nop                                       move.x vf09,vf06
        nop                                       move.y vf10,vf06
        nop                                       move.z vf11,vf06
        nop                                       move.w vf08,vf06
        addz.x vf06,vf00,vf08z                    nop
        addw.y vf06,vf00,vf09w                    nop
        addx.z vf08,vf00,vf10x                    move.x vf10,vf06
        muly.w vf09,vf00,vf11y                    move.w vf11,vf06
        ; I: double cubic coefficients
        nop[i]                                    loi 2
        muli.xyzw vf12,vf12,i                     nop
        muli.xyzw vf13,vf13,i                     nop
        muli.xyzw vf14,vf14,i                     nop
        muli.xyzw vf15,vf15,i                     nop
        muli.xyzw vf20,vf20,i                     nop
        nop                                       sq.xyzw vf08,23(vi04)
        nop                                       sq.xyzw vf09,24(vi04)
        nop                                       sq.xyzw vf10,25(vi04)
        nop                                       sq.xyzw vf11,26(vi04)
        nop                                       sq.xyzw vf12,27(vi04)
        nop                                       sq.xyzw vf13,28(vi04)
        nop                                       sq.xyzw vf14,29(vi04)
        nop                                       sq.xyzw vf15,30(vi04)
        nop                                       sq.xyzw vf20,31(vi04)
        nop                                       sq.xyzw vf21,32(vi04)
        return_saved_micro_link
end_native_routine mesh_prepare_light_basis

; Copy twelve fixed header qwords and the bounded header-directed material tail from the opposite double buffer. Preserve the original empty-tail branch.
begin_native_routine mesh_restore_previous_packet
        nop                                       iaddiu vi05,vi00,0x24e
        nop                                       isub vi05,vi05,vi04
        nop                                       iaddiu vi06,vi05,0
        nop                                       iaddiu vi08,vi04,0
        nop                                       iaddiu vi07,vi06,12
restore_fixed_header:
        nop                                       lqi.xyzw vf03,(vi06++)
        nop                                       nop
        nop                                       nop
        nop                                       ibne vi06,vi07,restore_fixed_header
        nop                                       sqi.xyzw vf03,(vi08++)
        nop                                       ilw.y vi07,packet_flags_qword(vi04)
        nop                                       iaddiu vi06,vi05,0x17
        nop                                       iaddiu vi08,vi04,0x17
        nop                                       iadd vi07,vi05,vi07
        nop                                       nop
        nop                                       ibeq vi07,vi06,restore_done
        nop                                       nop
restore_material_tail:
        nop                                       lqi.xyzw vf03,(vi06++)
        nop                                       nop
        nop                                       nop
        nop                                       ibne vi06,vi07,restore_material_tail
        nop                                       sqi.xyzw vf03,(vi08++)
restore_done:
        nop                                       jr vi15
        nop                                       nop
end_native_routine mesh_restore_previous_packet

; Pipelined four-qword vertex projection: fixed12 UV and fixed4 XYZ, homogeneous clipping, ADC/backface/status flags and screen conversion. VI7 cursor is four qwords per vertex.
begin_native_routine mesh_project_vertices
        nop                                       ilw.x vi01,packet_flags_qword(vi04)
        nop                                       lq.xyzw vf06,4(vi04)
        nop                                       lq.xyzw vf07,5(vi04)
        nop                                       lq.xyzw vf08,6(vi04)
        nop                                       lq.xyzw vf09,7(vi04)
        nop                                       iaddiu vi02,vi00,0x80
        nop                                       iand vi01,vi02,vi01
        nop                                       lq.xyzw vf01,8(vi04)
        nop                                       ibne vi01,vi00,project_load_screen_state
        nop                                       iaddi vi06,vi00,-1
        nop                                       iaddi vi06,vi00,0
project_load_screen_state:
        nop                                       lq.xyzw vf03,9(vi04)
        nop                                       lq.xyzw vf10,0(vi00)
        subw.x vf00,vf01,vf00w                    lq.xyzw vf11,1(vi00)
        nop                                       iadd vi08,vi04,vi08
        nop                                       iadd vi09,vi04,vi09
        nop                                       iadd vi07,vi00,vi08
        nop                                       fsand vi13,2
        nop                                       fcset 0
        nop                                       isw.x vi10,-1(vi07)
        mulx.w vf11,vf00,vf03x                    nop
        muly.w vf10,vf00,vf03y                    nop
        nop                                       move.xyzw vf12,vf11
        nop                                       move.xyzw vf13,vf11
        nop                                       move.xyzw vf14,vf11
        ; I: ADC flag bias4096
        nop[i]                                    loi 4096
        ; I: ADC reject bias8192
        addi[i].x vf04,vf00,i                     loi 8192
        ; I: backface ADC bias16384
        addi[i].y vf04,vf00,i                     loi 16384
        addi.z vf04,vf00,i                        nop
        maxw.zw vf31,vf00,vf00w                   ibeq vi11,vi00,project_setup_clip_limit
        sub.xy vf31,vf00,vf00                     nop
        nop                                       lq.xy vf31,2(vi00)
project_setup_clip_limit:
        addw.z vf25,vf00,vf00w                    nop
        ; I: finite maximum protects non-clamped homogeneous lanes
        addz[i].w vf05,vf00,vf03z                 loi 3.4028234663852886e+38
        addi.xyz vf05,vf00,i                      nop
        nop                                       lq.xyzw vf15,3(vi07)
        itof4.xyz vf15,vf15                       nop
        mulax.xyzw acc,vf06,vf15x                 move.w vf11,vf15
        madday.xyzw acc,vf07,vf15y                nop
        maddaz.xyzw acc,vf08,vf15z                nop
        maddw.xyzw vf19,vf09,vf00w                lq.xyzw vf16,7(vi07)
        mini.xyzw vf15,vf19,vf05                  div q,vf00w,vf19w
        nop                                       lq.xy vf25,0(vi07)
        itof4.xyz vf16,vf16                       nop
        mulax.xyzw acc,vf06,vf16x                 move.w vf12,vf16
        madday.xyzw acc,vf07,vf16y                move.w vf26,vf19
        maddaz.xyzw acc,vf08,vf16z                nop
        maddw.xyzw vf20,vf09,vf00w                nop
        mulq.xyzw vf15,vf15,q                     nop
        itof12.xy vf25,vf25                       nop
        clipw.xyz vf19,vf19                       lq.xyzw vf17,11(vi07)
        mini.xyzw vf16,vf20,vf05                  div q,vf00w,vf20w
        nop                                       nop
        mulq.xyz vf26,vf25,q                      nop
        addax.xyzw acc,vf11,vf00x                 nop
        itof4.xyz vf17,vf17                       nop
        madd.xyzw vf27,vf10,vf15                  lq.xy vf25,4(vi07)
        nop                                       sq.xyzw vf26,0(vi07)
        mulax.xyzw acc,vf06,vf17x                 move.w vf13,vf17
        madday.xyzw acc,vf07,vf17y                move.w vf26,vf20
        maddaz.xyzw acc,vf08,vf17z                nop
        maddw.xyzw vf21,vf09,vf00w                nop
        mulq.xyzw vf16,vf16,q                     iaddi vi07,vi07,4
        itof12.xy vf25,vf25                       nop
        clipw.xyz vf20,vf20                       lq.xyzw vf18,11(vi07)
        mini.xyzw vf17,vf21,vf05                  div q,vf00w,vf21w
        sub.xyzw vf23,vf16,vf15                   ibeq vi07,vi09,project_optional_alpha_scale
        mulq.xyz vf26,vf25,q                      sq.xyzw vf27,-1(vi07)
        addax.xyzw acc,vf12,vf00x                 nop
        itof4.xyz vf18,vf18                       nop
        madd.xyzw vf27,vf10,vf16                  lq.xy vf25,4(vi07)
        nop                                       sq.xyzw vf26,0(vi07)
        mulax.xyzw acc,vf06,vf18x                 move.w vf14,vf18
        madday.xyzw acc,vf07,vf18y                move.w vf26,vf21
        maddaz.xyzw acc,vf08,vf18z                nop
        maddw.xyzw vf22,vf09,vf00w                nop
        mulq.xyzw vf17,vf17,q                     iaddi vi07,vi07,4
        itof12.xy vf25,vf25                       nop
        clipw.xyz vf21,vf21                       lq.xyzw vf15,11(vi07)
        mini.xyzw vf18,vf22,vf05                  div q,vf00w,vf22w
        sub.xyzw vf24,vf17,vf16                   ibeq vi07,vi09,project_optional_alpha_scale
        mulq.xyz vf26,vf25,q                      sq.xyzw vf27,-1(vi07)
mesh_project_vertices_continue:
; Genuine additional entry into this native body; no duplicate source span.
.local mesh_project_vertices_continue
        addax.xyzw acc,vf13,vf00x                 nop
        itof4.xyz vf15,vf15                       move.xyzw vf01,vf19
        madd.xyzw vf27,vf10,vf17                  lq.xy vf25,4(vi07)
        mulay.x acc,vf23,vf24y                    sq.xyzw vf26,0(vi07)
        msuby.x vf00,vf24,vf23y                   fcand vi01,0x3ffff
        mulax.xyzw acc,vf06,vf15x                 move.w vf11,vf15
        madday.xyzw acc,vf07,vf15y                move.w vf26,vf22
        maddaz.xyzw acc,vf08,vf15z                ibeq vi01,vi00,project_lane0_clip_done
        maddw.xyzw vf19,vf09,vf00w                fsand vi02,2
        mul.xyzw vf28,vf01,vf31                   mtir vi12,vf27w
        mul.xyzw vf29,vf20,vf31                   bal vi14,mesh_classify_triangle
        mul.xyzw vf30,vf21,vf31                   fcor vi01,0xfdf7df
        clipw.xyz vf20,vf20                       nop
        clipw.xyz vf21,vf21                       nop
project_lane0_clip_done:
        mulq.xyzw vf18,vf18,q                     iaddi vi07,vi07,4
        itof12.xy vf25,vf25                       ibne vi02,vi06,project_lane0_adc_done
        clipw.xyz vf22,vf22                       lq.xyzw vf16,11(vi07)
        addz.w vf27,vf27,vf04z                    nop
project_lane0_adc_done:
        mini.xyzw vf15,vf19,vf05                  div q,vf00w,vf19w
        sub.xyzw vf23,vf18,vf17                   ibeq vi07,vi09,project_optional_alpha_scale
        mulq.xyz vf26,vf25,q                      sq.xyzw vf27,-1(vi07)
        addax.xyzw acc,vf14,vf00x                 nop
        itof4.xyz vf16,vf16                       move.xyzw vf01,vf20
        madd.xyzw vf27,vf10,vf18                  lq.xy vf25,4(vi07)
        mulay.x acc,vf23,vf24y                    sq.xyzw vf26,0(vi07)
        msuby.x vf00,vf24,vf23y                   fcand vi01,0x3ffff
        mulax.xyzw acc,vf06,vf16x                 move.w vf12,vf16
        madday.xyzw acc,vf07,vf16y                move.w vf26,vf19
        maddaz.xyzw acc,vf08,vf16z                ibeq vi01,vi00,project_lane1_clip_done
        maddw.xyzw vf20,vf09,vf00w                fsand vi02,2
        mul.xyzw vf28,vf01,vf31                   mtir vi12,vf27w
        mul.xyzw vf29,vf21,vf31                   bal vi14,mesh_classify_triangle
        mul.xyzw vf30,vf22,vf31                   fcor vi01,0xfdf7df
        clipw.xyz vf21,vf21                       nop
        clipw.xyz vf22,vf22                       nop
project_lane1_clip_done:
        mulq.xyzw vf15,vf15,q                     iaddi vi07,vi07,4
        itof12.xy vf25,vf25                       ibne vi02,vi06,project_lane1_adc_done
        clipw.xyz vf19,vf19                       lq.xyzw vf17,11(vi07)
        addz.w vf27,vf27,vf04z                    nop
project_lane1_adc_done:
