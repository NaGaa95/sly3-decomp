        nop                                       b material_normalize_direction
        nop                                       nop
material_global_direction:
        nop                                       lq.xyzw vf05,7(vi00)
        sub.xyz vf05,vf00,vf05                    nop
        linear_xyz vf05,vf29,vf30,vf31,vf05
material_normalize_direction:
