; Load four packet-directed affine matrices, transform the fixed4 position by each and blend their XYZ outputs using original integer weights normalized by1/255. Propagate duplicate position links.
begin_native_routine mesh_skin_positions
        nop                                       lq.xyzw vf20,packet_matrices_qword(vi04)
