        nop                                       mtir vi05,vf12z
        nop                                       iadd vi05,vi04,vi05
        nop                                       nop
        nop                                       ibltz vi05,material_modulate_rgb_alpha
        nop                                       nop
        nop                                       ibeq vi05,vi04,material_restore_link
        nop                                       nop
        nop                                       iadd vi06,vi06,vi10
        nop                                       nop
        nop                                       b material_next_normal
        nop                                       nop
