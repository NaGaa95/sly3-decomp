        maddw.xyz vf21,vf06,vf00w                 nop
        ; I: byte weight normalization1/255
        itof0[i].xyzw vf20,vf20                   loi 0.0039215688593685627
        mulax.xyz acc,vf07,vf19x                  nop
        madday.xyz acc,vf08,vf19y                 nop
        maddaz.xyz acc,vf09,vf19z                 nop
        maddw.xyz vf22,vf10,vf00w                 nop
        muli.xyzw vf20,vf20,i                     nop
        mulax.xyz acc,vf11,vf19x                  nop
        madday.xyz acc,vf12,vf19y                 nop
        maddaz.xyz acc,vf13,vf19z                 nop
        maddw.xyz vf23,vf14,vf00w                 nop
