; Whole original renderer upload generated by the native DVP MPG assembler.
; The canonical algorithm source keeps .vu and ELF-size metadata conditional
; because MPG itself establishes VU space and splits the280 instructions.
.global render_upload_begin
.global render_upload_end
render_upload_begin:
mpg 0,*
.include "renderer_program.vsm"
.endmpg
render_upload_end:
